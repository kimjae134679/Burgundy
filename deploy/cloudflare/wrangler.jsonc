{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burgundy-v26-online",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/events", "/health"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "BurgundyHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BurgundyHub"] }
  ],
  "observability": { "enabled": true }
}
